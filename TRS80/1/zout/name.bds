0000 0000 f name.asm
0000 0000 s ; name.asm
0000 0000 s ;   Ask for name and say hello (no LDOS)
0000 0000 s ;
0000 0000 s ; zmac name.asm
0000 0000 s ; trs80gp -b main zout/name.bds
5200 5200 s   org $5200
5200 5200 s 
5200 5200 s video   equ $3c00  ; video memory
5200 5200 s kbdport equ $3800  ; keyboard port base
5200 5200 s 
5200 5200 s main:
5200 5200 s   ; Clear screen with spaces
5200 5200 d 21003c
5200 5200 u 03 01
5200 5200 s   ld hl,video
5203 5203 d 010004
5203 5203 u 03 01
5203 5203 s   ld bc,1024
5206 5206 d 3e20
5206 5206 u 02 01
5206 5206 s   ld a,$20       ; space with bit 7 clear
5208 5208 s clear_loop:
5208 5208 d 77
5208 5208 u 01 01
5208 5208 s   ld (hl),a
5209 5209 d 23
5209 5209 u 01 01
5209 5209 s   inc hl
520a 520a d 0b
520a 520a u 01 01
520a 520a s   dec bc
520b 520b d 78
520b 520b u 01 01
520b 520b s   ld a,b
520c 520c d b1
520c 520c u 01 01
520c 520c s   or c
520d 520d d 20f9
520d 520d u 02 01
520d 520d s   jr nz,clear_loop
520f 520f s 
520f 520f s   ; Display "WHAT IS YOUR NAME? "
520f 520f d 21003c
520f 520f u 03 01
520f 520f s   ld hl,video
5212 5212 d 116d52
5212 5212 u 03 01
5212 5212 s   ld de,prompt
5215 5215 d cd3952
5215 5215 u 03 01
5215 5215 s   call print_msg
5218 5218 s 
5218 5218 s   ; Get input into buffer
5218 5218 d 21133c
5218 5218 u 03 01
5218 5218 s   ld hl,video+19  ; cursor position
521b 521b d 118952
521b 521b u 03 01
521b 521b s   ld de,buffer
521e 521e d cd4152
521e 521e u 03 01
521e 521e s   call get_keys
5221 5221 s 
5221 5221 s   ; Display "HELLO, "
5221 5221 d 21403c
5221 5221 u 03 01
5221 5221 s   ld hl,video+64
5224 5224 d 118152
5224 5224 u 03 01
5224 5224 s   ld de,hello_msg
5227 5227 d cd3952
5227 5227 u 03 01
5227 5227 s   call print_msg
522a 522a s 
522a 522a s   ; Display the name
522a 522a d 21473c
522a 522a u 03 01
522a 522a s   ld hl,video+71
522d 522d d 118952
522d 522d u 03 01
522d 522d s   ld de,buffer
5230 5230 d cd3952
5230 5230 u 03 01
5230 5230 s   call print_msg
5233 5233 s 
5233 5233 s   ; Wait a bit then restart
5233 5233 d 0600
5233 5233 u 02 01
5233 5233 s   ld b,0
5235 5235 s wait_loop:
5235 5235 d 10fe
5235 5235 u 02 01
5235 5235 s   djnz wait_loop
5237 5237 d 18c7
5237 5237 u 02 01
5237 5237 s   jr main
5239 5239 s 
5239 5239 s ; Print message from DE to screen at HL
5239 5239 s print_msg:
5239 5239 d 1a
5239 5239 u 01 01
5239 5239 s   ld a,(de)
523a 523a d b7
523a 523a u 01 01
523a 523a s   or a
523b 523b d c8
523b 523b u 01 01
523b 523b s   ret z
523c 523c d 77
523c 523c u 01 01
523c 523c s   ld (hl),a
523d 523d d 23
523d 523d u 01 01
523d 523d s   inc hl
523e 523e d 13
523e 523e u 01 01
523e 523e s   inc de
523f 523f d 18f8
523f 523f u 02 01
523f 523f s   jr print_msg
5241 5241 s 
5241 5241 s ; Get keyboard input at screen pos HL, store in buffer at DE
5241 5241 s get_keys:
5241 5241 d e5
5241 5241 u 01 01
5241 5241 s   push hl
5242 5242 d d5
5242 5242 u 01 01
5242 5242 s   push de
5243 5243 s input_loop:
5243 5243 s   ; Simple keyboard scan - check keyboard memory
5243 5243 d 3a4038
5243 5243 u 03 01
5243 5243 s   ld a,($3840)   ; keyboard buffer location
5246 5246 d b7
5246 5246 u 01 01
5246 5246 s   or a
5247 5247 d 28fa
5247 5247 u 02 01
5247 5247 s   jr z,input_loop
5249 5249 s   
5249 5249 d fe0d
5249 5249 u 02 01
5249 5249 s   cp $0d         ; Enter key?
524b 524b d 281b
524b 524b u 02 01
524b 524b s   jr z,input_done
524d 524d s   
524d 524d s   ; Store and display character
524d 524d d d1
524d 524d u 01 01
524d 524d s   pop de
524e 524e d d5
524e 524e u 01 01
524e 524e s   push de
524f 524f d 12
524f 524f u 01 01
524f 524f s   ld (de),a
5250 5250 d d1
5250 5250 u 01 01
5250 5250 s   pop de
5251 5251 d 13
5251 5251 u 01 01
5251 5251 s   inc de
5252 5252 d d5
5252 5252 u 01 01
5252 5252 s   push de
5253 5253 s   
5253 5253 d d1
5253 5253 u 01 01
5253 5253 s   pop de
5254 5254 d d5
5254 5254 u 01 01
5254 5254 s   push de
5255 5255 d e1
5255 5255 u 01 01
5255 5255 s   pop hl
5256 5256 d e5
5256 5256 u 01 01
5256 5256 s   push hl
5257 5257 d 77
5257 5257 u 01 01
5257 5257 s   ld (hl),a
5258 5258 d 23
5258 5258 u 01 01
5258 5258 s   inc hl
5259 5259 d e5
5259 5259 u 01 01
5259 5259 s   push hl
525a 525a s   
525a 525a s   ; Clear keyboard buffer
525a 525a d af
525a 525a u 01 01
525a 525a s   xor a
525b 525b d 324038
525b 525b u 03 01
525b 525b s   ld ($3840),a
525e 525e s   
525e 525e s   ; Small delay
525e 525e d 0632
525e 525e u 02 01
525e 525e s   ld b,50
5260 5260 s delay:
5260 5260 d 10fe
5260 5260 u 02 01
5260 5260 s   djnz delay
5262 5262 s   
5262 5262 d e1
5262 5262 u 01 01
5262 5262 s   pop hl
5263 5263 d d1
5263 5263 u 01 01
5263 5263 s   pop de
5264 5264 d e5
5264 5264 u 01 01
5264 5264 s   push hl
5265 5265 d d5
5265 5265 u 01 01
5265 5265 s   push de
5266 5266 d 18db
5266 5266 u 02 01
5266 5266 s   jr input_loop
5268 5268 s 
5268 5268 s input_done:
5268 5268 s   ; Null terminate
5268 5268 d d1
5268 5268 u 01 01
5268 5268 s   pop de
5269 5269 d af
5269 5269 u 01 01
5269 5269 s   xor a
526a 526a d 12
526a 526a u 01 01
526a 526a s   ld (de),a
526b 526b d e1
526b 526b u 01 01
526b 526b s   pop hl
526c 526c d c9
526c 526c u 01 01
526c 526c s   ret
526d 526d s 
526d 526d d 5748415420495320594f5552204e414d453f2000
526d 526d u 14 02
526d 526d s prompt    defb 'WHAT IS YOUR NAME? ',0
5281 5281 d 48454c4c4f2c2000
5281 5281 u 08 02
5281 5281 s hello_msg defb 'HELLO, ',0
5289 5289 s buffer    defs 20,0
5289 5289 d 00000000000000000000000000000000
5299 5299 d 00000000
5289 5289 u 14 02
529d 529d s 
529d 529d s   end main
5200 e
3800 v kbdport
5260 a delay
5289 a buffer
5208 a clear_loop
5239 a print_msg
