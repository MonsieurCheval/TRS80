binary-debuggable-source
0000 0000 f hello_ldos6.asm
0000 0000 s ; business_ldos6.asm
0000 0000 s ;   The TRS-80 lets the user know it supports business TRS-80s
0000 0000 s ; Reference doc:
0000 0000 s ;   The Programmer's Guide to TRSDOS Version 6 (also LDOS Version 6)
0000 0000 s ;
0000 0000 s ; zmac hello_ldos6.asm
0000 0000 s ; trs80gp -m2 -ld zout/business_ldos6.cmd
0000 0000 s ; trs80gp -m12 -ld zout/business_ldos6.cmd
0000 0000 s ; trs80gp -m16 -ld zout/business_ldos6.cmd
0000 0000 s ; trs80gp -m4 -ld zout/business_ldos6.cmd
7000 7000 s   org $7000
7000 7000 s 
7000 7000 s @DSPLY	equ	10 ; pg 7-19
7000 7000 s @EXIT	equ	22 ; pg 7-19
7000 7000 s 
7000 7000 s ENTER	equ	$0d ; @DSPLY with newline
7000 7000 s 
7000 7000 d 48656c6c6f2c20427573696e657373205452532d383020576f726c64210d
7000 7000 u 1e 02
7000 7000 s text	defb	'Hello, Business TRS-80 World!',ENTER
701e 701e s 
701e 701e s main:
701e 701e d 210070
701e 701e u 03 01
701e 701e s   ld hl,text
7021 7021 d 3e0a
7021 7021 u 02 01
7021 7021 s   ld a,@DSPLY
7023 7023 d ef
7023 7023 u 01 01
7023 7023 s   rst 40
7024 7024 s 
7024 7024 d 210000
7024 7024 u 03 01
7024 7024 s   ld hl,0 ; Normal termination
7027 7027 d 3e16
7027 7027 u 02 01
7027 7027 s   ld a,@EXIT
7029 7029 d ef
7029 7029 u 01 01
7029 7029 s   rst 40
702a 702a s 
702a 702a s   end main
701e e
701e a main
0016 v @EXIT
000d v ENTER
000a v @DSPLY
7000 a text
