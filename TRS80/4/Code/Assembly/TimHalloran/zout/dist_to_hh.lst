  16:				
  17:				; Returns c if hl >= (addr). Complex because we are doing a 16-bit comparison.
  18:				check_hh	macro	addr,?chk_lsb,?next
  19:						ld de,(addr)	; Do the table lookup for this half-height.
  20:						ld a,h
  21:						cp d
  22:						jr c,?next	; h < d  : msb dist < msb table lookup
  23:						jr z,?chk_lsb	; h = d  : msb dist = msb table lookup
  24:						ret		; h > d	 : msb dist > msb table lookup
  25:				?chk_lsb:	ld a,l
  26:						cp e
  27:						jr c,?next	; l < e  : lsb dist < lsb table lookup
  28:						ret		; l >= e : lsb dist >= lsb table lookup
  29:				?next:		inc c
  30:						endm
  31:				
  32:				; Returns the half-height of a wall given the passed distance to it.
