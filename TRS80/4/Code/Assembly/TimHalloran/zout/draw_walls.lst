   7:				;
   8:				; Author: Tim Halloran
   9:				; From the tutorial at https://lodev.org/cgtutor/raycasting.html
  10:				
  11:				; Draws vertical lines that act as walls for a 11-line ray caster.
  12:				; Two types of walls are supported:
  13:				;         solid: |    outline: ·
  14:				;                | |             ·
  15:				;                |             ·
  16:				; Why two types? We want to allow drawing of running into X or Y walls in the
  17:				; raycaster in different styles -- this looks much better to the user.
  18:				;
  19:				; Walls may only take up to 11 vertical character positions on the screen.
  20:				; If displaying the top of the screen, then pass a character address on
  21:				; the 6th line of video memory (or back buffer representing the display).
  22:				;
  23:				; All of the code below is implementation details except:
  24:				;
  25:				; draw_solid_wall   : draws a vertical line centered on the passed addr
  26:				;                     with the given half-height.
  27:				; draw_outline_wall : draws the top and bottom dot of a vertical line
  28:				;                     centered on the passed addr with the given half-height.
  29:				
  30:				; Draws the center character position of a solid wall. The center
  31:				; character position, unlike all others, has only a one or two
  32:				; half-height.
  33:				; Entry:
  34:				;  ix = addr of the center char position.
  35:				;  iy = addr of the half-height of the desired line
  36:				; Exit:
  37:				;  c = the remaining half-height of the desired line
  38:				; @private
  39:				solid_center_wall_seg	macro	?hh1,?hh2,?hh3
  40:							ld a,(iy)
  41:							; We'll hold the remaining half-height in c.
  42:							ld c,a
  43:							or a
  44:							; Check if the half-height is zero.
  45:							jr nz,?hh1
  46:							ret
  47:				?hh1:			dec c
  48:							jr nz,?hh2
  49:							ld a,$8c	; r and l mid dots.
  50:							ld (ix),a
  51:							ret
  52:				?hh2:			dec c
  53:							jr nz,?hh3
  54:							ld a,$bb	; r and l top and bot dots, l mid.
  55:							ld (ix),a
  56:							ret
  57:				?hh3:			ld a, $95	; all l dots.
  58:							ld (ix),a
  59:							endm
  60:				
  61:				; Draws the outline at the center character position of a black wall,
  62:				; if necessary. The center character position, unlike all others, has
  63:				; only a one or two half-height.
  64:				; Entry:
  65:				;  ix = addr of the center char position.
  66:				;  iy = addr of the half-height of the desired line
  67:				; Exit:
  68:				;  c = the remaining half-height of the desired line
  69:				; @private
  70:				outline_center_wall_seg	macro	?hh1,?hh2,?hh3
  71:							ld a,(iy)
  72:							; We'll hold the remaining half-height in c.
  73:							ld c,a
  74:							or a
  75:							; Check if the half-height is zero.
  76:							jr nz,?hh1
  77:							ret
  78:				?hh1:			dec c
  79:							jr nz,?hh2
  80:							ld a,$8c	; r and l mid dots.
  81:							ld (ix),a
  82:							ret
  83:				?hh2:			dec c
  84:							jr nz,?hh3
  85:							ld a,$b3	; r and l top and bot dots.
  86:							ld (ix),a
  87:							ret
  88:				?hh3:			nop
  89:							endm
  90:				
  91:				; Draws a segment of the solid wall above and below the center character
  92:				; position.
  93:				; Entry:
  94:				;  ix = addr of the char position above the center.
  95:				;  iy = addr of the char position below the center.
  96:				; Exit:
  97:				;  c = the remaining half-height of the desired line
  98:				; @private
  99:				solid_wall_seg		macro	?hh2,?hh3,?hh4
 100:							dec c
 101:							jr nz,?hh2
 102:							ld a,$b0	; r and l bottom dots.
 103:							ld (ix),a
 104:							ld a,$83	; r and l top dots.
 105:							ld (iy),a
 106:							ret
 107:				?hh2:			dec c
 108:							jr nz,?hh3
 109:							ld a,$9c	; r and l mid dots, l bottom.
 110:							ld (ix),a
 111:							ld a,$8d	; r and l mid 2 dots, l top.
 112:							ld (iy),a
 113:							ret
 114:				?hh3:			dec c
 115:							jr nz,?hh4
 116:							ld a,$97	; r and l top dots, l mid & bot.
 117:							ld (ix),a
 118:							ld a,$b5	; r and l bottom dots, l mid & top.
 119:							ld (iy),a
 120:							ret
 121:				?hh4:			ld a, $95	; all l dots.
 122:							ld (ix),a
 123:							ld (iy),a
 124:							endm
 125:				
 126:				; Draws the outline of a black wall above and below the center character
 127:				; position, if necessary.
 128:				; Entry:
 129:				;  ix = addr of the char position above the center.
 130:				;  iy = addr of the char position below the center.
 131:				; Exit:
 132:				;  c = the remaining half-height of the desired line
 133:				; @private
 134:				outline_wall_seg	macro	?hh2,?hh3,?hh4
 135:							dec c
 136:							jr nz,?hh2
 137:							ld a,$b0	; r and l bottom dots.
 138:							ld (ix),a
 139:							ld a,$83	; r and l top dots.
 140:							ld (iy),a
 141:							ret
 142:				?hh2:			dec c
 143:							jr nz,?hh3
 144:							ld a,$8c	; r and l mid dots.
 145:							ld (ix),a
 146:							ld a,$8c	; r and l mid dots.
 147:							ld (iy),a
 148:							ret
 149:				?hh3:			dec c
 150:							jr nz,?hh4
 151:							ld a,$83	; r and l top dots.
 152:							ld (ix),a
 153:							ld a,$b0	; r and l bottom dots.
 154:							ld (iy),a
 155:							ret
 156:				?hh4:			nop
 157:							endm
 158:				
 159:				; Stepping up and down from the address passed the the ray drawing routine
 160:				; by a line ('buff_line_width' bytes) this routine updates the memory
 161:				; locations:
 162:     -	0000  0000    	char_above_addr	defw	0
 163:     -	0002  0000    	char_below_addr	defw	0
 164:				; Exit:
 165:				;  ix = addr of the char position above the center.
 166:				;  iy = addr of the char position below the center.
 167:				; @private
