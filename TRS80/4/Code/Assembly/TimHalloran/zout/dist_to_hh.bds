0000 0000 s ; From the tutorial at https://lodev.org/cgtutor/raycasting.html
0000 0000 s 
0000 0000 s ; Returns c if hl >= (addr). Complex because we are doing a 16-bit comparison.
0000 0000 s check_hh	macro	addr,?chk_lsb,?next
0000 0000 s 		ld de,(addr)	; Do the table lookup for this half-height.
0000 0000 s 		ld a,h
0000 0000 s 		cp d
0000 0000 s 		jr c,?next	; h < d  : msb dist < msb table lookup
0000 0000 s 		jr z,?chk_lsb	; h = d  : msb dist = msb table lookup
0000 0000 s 		ret		; h > d	 : msb dist > msb table lookup
0000 0000 s ?chk_lsb:	ld a,l
0000 0000 s 		cp e
0000 0000 s 		jr c,?next	; l < e  : lsb dist < lsb table lookup
0000 0000 s 		ret		; l >= e : lsb dist >= lsb table lookup
0000 0000 s ?next:		inc c
0000 0000 s 		endm
0000 0000 s 
0000 0000 s ; Returns the half-height of a wall given the passed distance to it.
0000 0000 s ;
0000 0000 s ; Uses: a,c,de,hl
0000 0000 s ;
0000 0000 s ; Enter: hl  distance to wall.
0000 0000 s ; Exit:  c   half-height of wall: (1,17).
0000 0000 d 0e01
0000 0000 u 02 01
0000 0000 s dist_to_hh:	ld c,1
