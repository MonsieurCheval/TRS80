binary-debuggable-source
0000 0000 f add.asm
0000 0000 s ; add.asm
0000 0000 s ;   Adds a few numbers (no screen output)
0000 0000 s ;
0000 0000 s ; zmac add.asm
0000 0000 s ; trs80gp -b main zout/add.bds
5200 5200 s   org $5200
5200 5200 s 
5200 5200 d 02
5200 5200 u 01 02
5200 5200 s num	defb	2
5201 5201 s main:
5201 5201 s   ; 8-bit math
5201 5201 d 3e05
5201 5201 u 02 01
5201 5201 s   ld a,5     ; a = 5
5203 5203 d 3c
5203 5203 u 01 01
5203 5203 s   inc a      ; a = 6
5204 5204 d 3d
5204 5204 u 01 01
5204 5204 s   dec a      ; a = 5
5205 5205 s 
5205 5205 d 3a0052
5205 5205 u 03 01
5205 5205 s   ld a,(num) ; load 2 from num into a
5208 5208 d 3c
5208 5208 u 01 01
5208 5208 s   inc a      ; a = 3
5209 5209 d 3d
5209 5209 u 01 01
5209 5209 s   dec a      ; a = 2
520a 520a d 0e0a
520a 520a u 02 01
520a 520a s   ld c,10    ; c = 10
520c 520c d 81
520c 520c u 01 01
520c 520c s   add c      ; a = 12, c = 10
520d 520d d 320052
520d 520d u 03 01
520d 520d s   ld (num),a ; store 12 into num
5210 5210 s 
5210 5210 s   ; We can do 16-bit math too
5210 5210 d 210002
5210 5210 u 03 01
5210 5210 s   ld hl,512  ; hl = 512
5213 5213 d 010002
5213 5213 u 03 01
5213 5213 s   ld bc,512  ; bc = 512
5216 5216 d 09
5216 5216 u 01 01
5216 5216 s   add hl,bc  ; hl = 1024
5217 5217 s 
5217 5217 s   ; reset "num" to repeat
5217 5217 d 3e02
5217 5217 u 02 01
5217 5217 s   ld a,2     ; a = 2
5219 5219 d 320052
5219 5219 u 03 01
5219 5219 s   ld (num),a ; store 2 into num (via a)
521c 521c s 
521c 521c d 18e3
521c 521c u 02 01
521c 521c s   jr main    ; jump back up to main and repeat until reboot
521e 521e s   end main
5201 e
5201 a main
5200 a num
